## Python gitignore

# Virtual environment
venv/
.venv/
env/
ENV/

# Bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Sensitive configuration — NEVER commit
.env

# Alembic (manter apenas versions/)
# alembic/versions/ ← manter commitado

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / PyCharm
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
